# === Docker 相關 ===
# 專案代號（compose 會自動補 -frontend 後綴，請勿自行加）
PROJECT_NAME=nuxt4-template
IMAGE_TAG=latest
HOST_PORT=3000

# === Nuxt Runtime Config ===
NUXT_APP_BASE_URL=/
# 統一 API domain（覆蓋 runtimeConfig.public.apiBase；預設同源相對路徑 /api）
# 只有跨網域部署（API 在別的 domain）才需要設絕對 URL，例如：
# NUXT_PUBLIC_API_BASE=https://api.example.com/api
NUXT_PUBLIC_API_BASE=/api
NUXT_PRIVATE_GOOGLE_SHEET_KEY=

# === 受保護模組內容（app/modules 四區塊的加解密腳本）===
# 密碼依序從三個地方找：這個環境變數 → macOS 鑰匙圈 → 互動輸入。
#
# 日常開發建議存鑰匙圈，這裡留空：
#   security add-generic-password -a "$USER" -s sport3d-protect -w
# （在真正的終端機裡跑，它會提示你輸入密碼且不回顯）
#
# 填值的時機只有 CI 或臨時覆寫。刻意不帶 NUXT_ 前綴：
# 這個值絕不可進 runtimeConfig（frontend-security.md #4）。
SPORT3D_PROTECT_PASSWORD=