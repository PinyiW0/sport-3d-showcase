# === Docker 相關 ===
# 專案代號（compose 會自動補 -frontend 後綴，請勿自行加）
PROJECT_NAME=nuxt4-template
IMAGE_TAG=latest
HOST_PORT=3000

# === Nuxt Runtime Config ===
NUXT_APP_BASE_URL=/
# 統一 API domain（覆蓋 runtimeConfig.public.apiBase；預設同源相對路徑 /api）
# 只有跨網域部署（API 在別的 domain）才需要設絕對 URL，例如：
# NUXT_PUBLIC_API_BASE=https://api.example.com/api
NUXT_PUBLIC_API_BASE=/api
NUXT_PRIVATE_GOOGLE_SHEET_KEY=

# === 受保護模組內容加解密（scripts/protect-encrypt.mjs / protect-decrypt.mjs） ===
# 留空即可：沒設就跑互動輸入，終端機會隱藏字元提示輸入密碼。
# 刻意不帶 NUXT_ 前綴——帶了前綴會誘導後人把它放進 runtimeConfig，
# 而 runtimeConfig.public 會打包進 client bundle，這支密碼絕不能到那裡（見 rules/frontend-security.md #4）。
SPORT3D_PROTECT_PASSWORD=
